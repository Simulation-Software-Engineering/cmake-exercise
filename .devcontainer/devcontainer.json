{
    "name": "DevContainer",
    "image": "docker.io/madebytimo/development",
    "remoteUser": "user",
    "privileged": false,
    "runArgs": ["--tmpfs", "/tmp:exec"],
    "postCreateCommand": {
        "apt": "sudo apt update -qq && sudo apt install -y -qq libboost-all-dev libdeal.ii-dev"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "esbenp.prettier-vscode",
                "foxundermoon.shell-format",
                "mads-hartmann.bash-ide-vscode",
                "mhutchie.git-graph",
                "ms-azuretools.vscode-docker",
                "ms-vscode.cmake-tools",
                "ms-vscode.cpptools",
                "redhat.vscode-yaml",
                "streetsidesoftware.code-spell-checker",
                "streetsidesoftware.code-spell-checker-german",
                "timonwong.shellcheck"
            ]
        }
    }
}
